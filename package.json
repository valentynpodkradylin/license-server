{
  "name": "ohflightbuilder-license-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "start:intercept": "node dist/src/intercept.js",
    "dev": "tsx src/server.ts",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "license:create": "tsx src/cli.ts license:create",
    "license:list": "tsx src/cli.ts license:list",
    "license:revoke": "tsx src/cli.ts license:revoke",
    "license:restore": "tsx src/cli.ts license:restore",
    "update:set": "tsx src/cli.ts update:set"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "better-sqlite3": "^12.6.2",
    "dotenv": "^16.6.1",
    "fastify": "^5.6.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
